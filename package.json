{
  "name": "svi",
  "version": "2.0.0",
  "description": "SVI - Sistema de Validação de Ingressos com pagamento via Stripe Checkout",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhook",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "stripe": "^23.0.1"
  }
}
