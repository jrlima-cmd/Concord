# Porta e URL pública (usada nos redirecionamentos do Stripe Checkout)
PORT=3000
BASE_URL=http://localhost:3000

# Stripe - https://dashboard.stripe.com/apikeys
# Use sk_test_... para testes e sk_live_... em produção
STRIPE_SECRET_KEY=sk_test_...
# Segredo do endpoint de webhook (whsec_...). Localmente: `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: métodos de pagamento separados por vírgula (ex.: card,pix,boleto).
# Deixe vazio para usar os métodos ativados no Dashboard da Stripe.
STRIPE_PAYMENT_METHODS=

# Evento
EVENT_NAME=Ingresso SVI
TICKET_PRICE_CENTS=5500
CURRENCY=brl
MAX_TICKETS_PER_ORDER=10

# Portaria
STAFF_PASSWORD=troque-esta-senha
# Segredo longo e aleatório para assinar as sessões da portaria
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
STAFF_SESSION_HOURS=12

# Banco de dados SQLite
DATABASE_FILE=data/svi.db
